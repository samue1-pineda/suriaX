#test lexer

// modelo de memoria: region-based + move-semantics
//   - 'region r { ... }' agrupa asignaciones; se liberan por region completa
//   - 'make T in r' / 'x at r' asocian un valor a una region
//   - 'move' transfiere la propiedad de un valor

fn promedio(int a, int b) -> int {
    /- la division entera basta para el ejemplo;
       este comentario multilinea es ignorado por el lexer -/
    mutable int total = a + b;
    return total / 2;
}

fn main() -> void {
    const int x = 10;

    region scratch {
        int ptr y = make int in scratch;   // se ubica 'y' en la region 'scratch'
        int z = promedio(x, 20) at scratch;
        move y;                            // move-semantics: transfiere 'y'
        int ptr p = &z;                    // direccion

        if z >= 10 and not false {
            str msg = "promedio alto: {z}\n";
            char grade = 'A';
            float ratio = 3.14;
        } else {
            return;
        }
    }   // al cerrar la region, su memoria se libera completa
}

// interoperabilidad C++: el cuerpo se captura crudo (RAW_BLOCK), no se tokeniza
#extern cpp{
    extern "C" int add(int a, int b) { return a + b; }
}
