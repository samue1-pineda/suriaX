/- Excepciones 13: los errores del runtime tambien se atrapan.

 Dividir entre cero o leer fuera de un indice no tiene resultado posible.
 Como en Python, eso no mata el programa de golpe: el runtime LANZA un
 valor, y el 'try' mas cercano lo recibe igual que un 'throw' del usuario.
 Los tipos estan en la libreria estandar 'excepciones':

     excepciones.DivisionPorCero      EXC001
     excepciones.IndiceFueraDeRango   EXC002

 Cada uno trae 'mensaje', 'linea' y 'columna' de la operacion que fallo.
 'catch (e)' sin tipo tambien los atrapa. Y como cualquier catch, puede
 convertirlos en un error PROPIO del programa y relanzarlo.

 (Una division entre un cero LITERAL, 'x / 0', ni siquiera compila: SEM035.
 Lo que se atrapa es el divisor que vale cero al ejecutar.)
-/
#from io #import stdp
#import excepciones as exc
#import array.vector as vec

struct { str que; int cuanto; } ErrorDeCalculo;

fn promedio(int total, int n) -> int {
    try { return total / n; }
    catch (exc.DivisionPorCero e) {
        // el error del runtime se traduce a uno que habla del problema
        throw ErrorDeCalculo{ que: "promedio de una lista vacia", cuanto: total };
    };
    return 0;
}

fn main() -> int {
    var int cero = 0;

    stdp.println("-- division entre una variable que vale cero");
    try { stdp.println(f"{10 / cero}"); }
    catch (exc.DivisionPorCero e) {
        stdp.println(f"  {e.mensaje} (linea {e.linea}, columna {e.columna})");
    };

    stdp.println("-- el resto tambien");
    try { stdp.println(f"{10 % cero}"); }
    catch (exc.DivisionPorCero e) { stdp.println(f"  {e.mensaje}"); };

    stdp.println("-- indice fuera de rango, y el vector sigue sirviendo");
    var vec.Vector<int> v = vec.dynamic<int>(2);
    v.push(10);
    v.push(20);
    try { stdp.println(f"{v.get(5)}"); }
    catch (exc.IndiceFueraDeRango e) { stdp.println(f"  {e.mensaje}"); };
    stdp.println(f"  v[1] sigue siendo {v.get(1)}");

    stdp.println("-- cada tipo cae en su rama");
    try { stdp.println(f"{v.get(9)}"); }
    catch (exc.DivisionPorCero e) { stdp.println("  no se ve"); }
    catch (exc.IndiceFueraDeRango e) { stdp.println("  rama del indice"); };

    stdp.println("-- sin tipo tambien se atrapan");
    try { stdp.println(f"{1 / cero}"); }
    catch (e) { stdp.println("  atrapado por 'catch (e)'"); };

    stdp.println("-- convertir el error del runtime en uno propio");
    try { promedio(30, 0); }
    catch (ErrorDeCalculo e) { stdp.println(f"  {e.que} (total {e.cuanto})"); };
    stdp.println(f"  y con datos: {promedio(30, 3)}");
    return 0;
}
