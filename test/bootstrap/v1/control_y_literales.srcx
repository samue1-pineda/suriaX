fn nada() -> void {
}

fn saluda(int veces) -> void {
    if (veces <= 0) { return; };
    nada();
    saluda(veces - 1);
}

fn clasifica(float x, float y) -> int {
    if (x < y and not (y > 100.5)) {
        return -1;
    } else if (x == y or x > 1000.0) {
        return 0;
    } else {
        return 1;
    };
}

fn main() -> int {
    var str s = "hola\n\t\"mundo\" ñ";
    const char c = 'z';
    var bool listo = false;
    var float f = -3.25;
    var int n = -9223372036854775807;
    if (true) {
        var int dentro = 0;
        dentro = dentro + 1;
    };
    while (not listo) {
        listo = s < "zzz" or c == 'a';
    };
    saluda(3);
    f = f * 2.0 - 0.5;
    n = -n;
    return clasifica(f, 1.5) + mas_tarde(0);
}

fn mas_tarde(int x) -> int {
    return x;
}
