#from io #import stdp

fn doble(int n) -> int { return n + n; }
fn solo_en_pruebas(int n) -> int { return n * 3; }

fn main() -> int {
    stdp.println(f"{doble(21)}");
    return 0;
}

test "doble" {
    var int r = doble(2);
    var int esperado = 4;
    expect (r == esperado) { stdp.println("bien"); };
    expect (solo_en_pruebas(1) == 3);
} errfinally {
    stdp.println("fallo");
} finally {
    stdp.println("fin");
}
