// 03 — condicionales y bucles: if / else if / else, while, break, continue.
#from io #import stdp

fn clasifica(int n) -> int {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}

fn main() -> int {
    var int i = -3;
    while (i <= 3) {
        stdp.println(f"clasifica({i}) = {clasifica(i)}");
        i = i + 1;
    }
    var int suma_pares = 0;
    var int k = 0;
    while (true) {
        k = k + 1;
        if (k > 20) {
            break;
        }
        if (k % 2 == 1) {
            continue;
        }
        suma_pares = suma_pares + k;
    }
    stdp.println(f"suma de pares 1..20 = {suma_pares}");
    var int fila = 1;
    while (fila <= 4) {
        var int col = 1;
        var int acc = 0;
        while (col <= fila) {
            acc = acc + fila * col;
            col = col + 1;
        }
        stdp.println(f"fila {fila}: {acc}");
        fila = fila + 1;
    }
    var bool listo = false;
    var int pasos = 0;
    while (not listo) {
        pasos = pasos + 1;
        listo = pasos >= 5 and pasos % 5 == 0;
    }
    stdp.println(f"pasos = {pasos}, listo = {listo}");
    return 0;
}
