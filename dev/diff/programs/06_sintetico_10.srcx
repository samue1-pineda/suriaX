#from io #import stdp

enum Color { ROJO, VERDE, AZUL, NEGRO };

fn mix(int a, int b) -> int {
    return (a * 31 + b) % 1000003;
}

fn half(float x) -> float {
    return x / 2.0;
}

fn label(int n) -> str {
    if (n % 2 == 0) {
        return "par";
    }
    return "impar";
}

fn letter(int n) -> char {
    if (n % 3 == 0) {
        return 'x';
    }
    return 'y';
}

fn pick(int n) -> Color {
    var int r = n % 4;
    if (r < 0) {
        r = 0 - r;
    }
    if (r == 0) {
        return Color.ROJO;
    }
    if (r == 1) {
        return Color.VERDE;
    }
    if (r == 2) {
        return Color.AZUL;
    }
    return Color.NEGRO;
}

fn color_code(Color c) -> int {
    match (c) {
        case Color.ROJO: { return 10; }
        case Color.VERDE: { return 20; }
        case Color.AZUL: { return 30; }
        case Color.NEGRO: { return 40; }
    }
    return 0;
}

fn is_small(int n) -> bool {
    return n < 500 and n > -500;
}

fn block_0(int seed) -> int {
    var int i0 = seed % 1000 + 87;
    var int i1 = (i0 - (-27)) * 3;
    stdp.println(f"b0 i1={i1}");
    stdp.println(f"b0 i0={i0}");
    stdp.println(f"b0 i0={i0}");
    return i1;
}

fn main() -> int {
    var int total = 0;
    total = mix(total, block_0(total));
    stdp.println(f"total = {total}");
    return 0;
}
