// 08 — desbordamiento de int. 'int' tiene 64 bits con signo y ENVUELVE al
// desbordar (documentation/source/type_system.rst): no es un error. Se mide si
// los tres targets envuelven igual.
#from io #import stdp

fn main() -> int {
    var int max = 9223372036854775807;
    var int min = 0 - 9223372036854775807 - 1;
    stdp.println(f"max = {max}");
    stdp.println(f"min = {min}");
    stdp.println(f"max + 1 = {max + 1}");
    stdp.println(f"min - 1 = {min - 1}");
    stdp.println(f"max * 2 = {max * 2}");
    stdp.println(f"max * max = {max * max}");
    stdp.println(f"-min = {0 - min}");
    stdp.println(f"min * -1 = {min * -1}");
    stdp.println(f"min % -1 = {min % -1}");
    var int acc = 1;
    var int i = 0;
    while (i < 70) {
        acc = acc * 3;
        i = i + 1;
    }
    stdp.println(f"3^70 envuelto = {acc}");
    var int grande = 4611686018427387904;
    stdp.println(f"2^62 + 2^62 = {grande + grande}");
    stdp.println(f"2^53 + 1 = {9007199254740992 + 1}");
    // al final a propósito: en wasm 'i64.div_s' de MIN entre -1 es un trap,
    // y lo que vaya después no se compararía
    stdp.println(f"min / -1 = {min / -1}");
    return 0;
}
