# Configuración del playground (playground/server.py).
#
# El servidor lee VARIABLES DE ENTORNO; este archivo solo es para el caso en
# el que no las inyecte una plataforma. Copia a '.env' y ajusta.
#
# Lo que ya viene del entorno GANA sobre lo que diga este archivo: si la
# plataforma define PORT, un '.env' olvidado no puede cambiar dónde escucha.
# Los valores de aquí son los de por defecto.

# Dónde escucha. 127.0.0.1 es SOLO esta máquina; 0.0.0.0 lo publica en la red
# (es lo que hace falta al desplegarlo).
HOST=127.0.0.1

# Puerto donde escucha. En una plataforma lo pone ella; no lo fijes allí.
PORT=8000

# Tamaño máximo del fuente que se acepta compilar, en bytes. Compilar es
# trabajo real y el servidor es público: esto es una cota, no seguridad.
SURIAX_MAX_SOURCE_BYTES=65536

# Segundos que puede tardar el backend web (TypeScript) en sus artefactos.
SURIAX_WEB_TIMEOUT=120

# Cuántos procesos del backend web (node) pueden correr a la vez.
SURIAX_WEB_CONCURRENCY=2

# Segundos que se espera a un cliente que no termina de enviar su petición.
SURIAX_CLIENT_TIMEOUT=30

# Un origen (https://otro.sitio) al que se le permite llamar a la API desde su
# propia página. Vacío: solo la página del playground.
SURIAX_CORS_ORIGIN=
