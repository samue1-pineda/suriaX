/- frontend.parser — el programa entero y la recuperación de errores
   (`V0/.../grammar/program.py` y `recovery.py`).

     program = { top_level } EOF

 Un error de sintaxis no detiene el análisis. El bucle atrapa el
 `ErrorDeSintaxis`, lo anota y SINCRONIZA: vuelve al inicio de la
 declaración que falló y la descarta entera, contando llaves desde cero,
 hasta el '}' que la cierra (o el ';' si no abrió ninguna). Así un error
 produce un diagnóstico, no una cascada.

 Diferencia conocida con la V0: la V0 convierte un anidamiento demasiado
 profundo en un error de sintaxis (PAR025). Aquí la recursión del parser
 corre en el propio suriaX, y agotar su pila es RT019, que no se puede
 atrapar: termina el programa.
-/

#from io #import stdp
#import frontend.tokens as tk
#import frontend.lexer as lx
#import frontend.cursor as cu
#import frontend.declaraciones as de
#import frontend.arbol as ar
#import array.vector as vec

/- Descarta la declaración que empezaba en `inicio`. Cada vuelta avanza o
   termina, así que siempre termina. -/
fn sincroniza(cu.Parser ptr mutable p, int inicio) -> void {
    p.pos = inicio;
    var int prof = 0;
    while (not cu.al_final(p)) {
        var tk.TType t = cu.actual(p).tipo;
        if (t == tk.TType.L_BRACE) {
            prof = prof + 1;
            cu.avanza(p);
        } else if (t == tk.TType.R_BRACE) {
            cu.avanza(p);
            if (prof <= 1) { return; }
            prof = prof - 1;
        } else if (prof == 0 and t == tk.TType.SEMICOLON) {
            cu.avanza(p);
            return;
        } else {
            cu.avanza(p);
        }
    }
}

/- El programa: la raíz del árbol, con cada declaración colgada de `items`.
   Un `@impl` se APLANA en sus métodos. Los errores se añaden a `errores`
   ("PARnnn linea:col mensaje"). -/
public fn programa(cu.Parser ptr mutable p, vec.Vector<str> ptr mutable errores) -> int {
    var int raiz = cu.nodo_en(p, "Program", cu.actual(p));
    while (not cu.al_final(p)) {
        var int inicio = p.pos;
        try {
            var int n = de.item(p);
            if (cu.clase(p, n) == "ImplDecl") {
                var vec.Vector<int> metodos = ar.hijos(&p.arbol, n);
                var int i = 0;
                while (i < metodos.len()) {
                    cu.hijo(p, raiz, "items", metodos.get(i));
                    i = i + 1;
                }
            } else {
                cu.hijo(p, raiz, "items", n);
            }
        } catch (cu.ErrorDeSintaxis e) {
            errores.push(f"{e.codigo} {e.linea}:{e.col} {e.mensaje}");
            // el contexto vuelve al del nivel superior: la declaración que
            // lo había cambiado se descarta entera
            p.sin_literal = false;
            p.bucles = 0;
            p.receptores = vec.dynamic<int>(4);
            p.en_finally = -1;
            sincroniza(p, inicio);
        };
    }
    return raiz;
}

/- `fuente` -> su árbol, volcado en el formato canónico, y después sus
   errores léxicos y de sintaxis ("error PARnnn linea:col mensaje"). -/
public fn analiza(str fuente) -> void {
    var vec.Vector<str> errores = vec.dynamic<str>(4);
    var vec.Vector<tk.Token> toks = lx.tokenizar(fuente, &errores);
    var int ultimo = toks.len() - 1;
    var cu.Parser p = cu.Parser{ toks: move toks, pos: 0, fin: ultimo,
                                 arbol: vec.dynamic<ar.Nodo>(64), sin_literal: false, bucles: 0,
                                 receptores: vec.dynamic<int>(4), guardianes: 0,
                                 en_finally: -1 };
    var vec.Vector<str> sintaxis = vec.dynamic<str>(4);
    var int raiz = programa(&p, &sintaxis);
    ar.vuelca(&p.arbol, raiz, 0);
    var int i = 0;
    while (i < errores.len()) {
        stdp.println("error " + errores.get(i));
        i = i + 1;
    }
    i = 0;
    while (i < sintaxis.len()) {
        stdp.println("error " + sintaxis.get(i));
        i = i + 1;
    }
}

#export as parser
