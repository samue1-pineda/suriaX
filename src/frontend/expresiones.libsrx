/- frontend.expresiones — el motor Pratt (`V0/.../pratt.py`, `precedence.py`,
   `expressions/nud.py` y `led.py`).

     expression = unary { OPERADOR_BINARIO unary }      (por precedencia)
     unary      = ( "not" | "-" | "&" ) unary | postfix
     postfix    = primary { "." NAME | "(" args ")" | "[" expression "]"
                          | "{" campos "}" | "<" tipos ">" ( "{" | "(" ) }
     primary    = NAME | literal | "(" expression ")" | sizeof | cast | move

 La precedencia de los operadores binarios es una tabla (`poder`); de menor
 a mayor: asignación (a la derecha), or, and, igualdad, comparación, suma,
 producto. Lo demás (unarios, postfijos) se resuelve por estructura, porque
 liga más fuerte que cualquier binario.
-/

#import frontend.tokens as tk
#import frontend.cursor as cu
#import frontend.tipos as ti
#import frontend.arbol as ar
#import frontend.lexer as lx
#import array.vector as vec

// --------------------------------------------------------------------------- //
// el bucle binario
// --------------------------------------------------------------------------- //

/- El poder de ligadura de un operador binario, o -1 si no lo es. -/
fn poder(tk.TType t) -> int {
    if (t == tk.TType.ASSIGN or t == tk.TType.PLUS_ASSIGN or t == tk.TType.MINUS_ASSIGN
            or t == tk.TType.STAR_ASSIGN or t == tk.TType.SLASH_ASSIGN
            or t == tk.TType.PERCENT_ASSIGN or t == tk.TType.AMP_ASSIGN
            or t == tk.TType.PIPE_ASSIGN or t == tk.TType.CARET_ASSIGN
            or t == tk.TType.SHIFT_LEFT_ASSIGN or t == tk.TType.SHIFT_RIGHT_ASSIGN) { return 10; }
    if (t == tk.TType.OR) { return 20; }
    if (t == tk.TType.AND) { return 30; }
    if (t == tk.TType.EQUAL or t == tk.TType.NOT_EQUAL) { return 40; }
    if (t == tk.TType.LESS or t == tk.TType.LESS_EQUAL or t == tk.TType.GREATER
            or t == tk.TType.GREATER_EQUAL) { return 50; }
    // bits: entre las comparaciones y la suma, como en Python y Rust
    if (t == tk.TType.PIPE) { return 52; }
    if (t == tk.TType.CARET) { return 54; }
    if (t == tk.TType.ADDRESS) { return 56; }
    if (t == tk.TType.SHIFT_LEFT or t == tk.TType.SHIFT_RIGHT) { return 58; }
    if (t == tk.TType.PLUS or t == tk.TType.MINUS) { return 60; }
    if (t == tk.TType.MULTIPLY or t == tk.TType.DIVIDE or t == tk.TType.MODULO) { return 70; }
    return -1;
}

public fn expresion(cu.Parser ptr mutable p) -> int { return con_minimo(p, 0); }

/- Precedence climbing: el operando derecho de un operador a la izquierda
   exige un poder MAYOR (así `a - b - c` es `(a - b) - c`); el de la
   asignación, el mismo (así `a = b = c` es `a = (b = c)`). -/
fn con_minimo(cu.Parser ptr mutable p, int minimo) -> int {
    var int izq = unaria(p);
    while (true) {
        var tk.Token op = cu.actual(p);
        // '>>' y '>>=': un '>' seguido PEGADO de '>' o de '>='. El lexer no
        // los junta para que 'Vector<Vector<int>>' cierre dos genericos.
        var int ocupa = 1;
        if (op.tipo == tk.TType.GREATER) {
            var tk.Token sig = cu.mira(p, 1);
            if (sig.linea == op.linea and sig.col == op.col + 1) {
                if (sig.tipo == tk.TType.GREATER) {
                    op = tk.token(tk.TType.SHIFT_RIGHT, ">>", op.linea, op.col);
                    ocupa = 2;
                } else if (sig.tipo == tk.TType.GREATER_EQUAL) {
                    op = tk.token(tk.TType.SHIFT_RIGHT_ASSIGN, ">>=", op.linea, op.col);
                    ocupa = 2;
                }
            }
        }
        var int bp = poder(op.tipo);
        if (bp < 0 or bp < minimo) { return izq; }
        cu.avanza(p);
        if (ocupa == 2) { cu.avanza(p); }
        var int siguiente = bp + 1;
        if (bp == 10) { siguiente = bp; }
        var int der = con_minimo(p, siguiente);
        izq = infija(p, op, izq, der);
    }
    return izq;
}

fn binario(tk.TType t) -> str {
    if (t == tk.TType.OR) { return "or"; }
    if (t == tk.TType.AND) { return "and"; }
    if (t == tk.TType.EQUAL) { return "=="; }
    if (t == tk.TType.NOT_EQUAL) { return "!="; }
    if (t == tk.TType.LESS) { return "<"; }
    if (t == tk.TType.LESS_EQUAL) { return "<="; }
    if (t == tk.TType.GREATER) { return ">"; }
    if (t == tk.TType.GREATER_EQUAL) { return ">="; }
    if (t == tk.TType.PLUS) { return "+"; }
    if (t == tk.TType.MINUS) { return "-"; }
    if (t == tk.TType.MULTIPLY) { return "*"; }
    if (t == tk.TType.DIVIDE) { return "/"; }
    if (t == tk.TType.PIPE) { return "|"; }
    if (t == tk.TType.CARET) { return "^"; }
    if (t == tk.TType.ADDRESS) { return "&"; }
    if (t == tk.TType.SHIFT_LEFT) { return "<<"; }
    if (t == tk.TType.SHIFT_RIGHT) { return ">>"; }
    return "%";
}

/- `x += v` -> "+" (el operador en que se expande), o "" si no es compuesto. -/
fn compuesto(tk.TType t) -> str {
    if (t == tk.TType.PLUS_ASSIGN) { return "+"; }
    if (t == tk.TType.MINUS_ASSIGN) { return "-"; }
    if (t == tk.TType.STAR_ASSIGN) { return "*"; }
    if (t == tk.TType.SLASH_ASSIGN) { return "/"; }
    if (t == tk.TType.PERCENT_ASSIGN) { return "%"; }
    if (t == tk.TType.AMP_ASSIGN) { return "&"; }
    if (t == tk.TType.PIPE_ASSIGN) { return "|"; }
    if (t == tk.TType.CARET_ASSIGN) { return "^"; }
    if (t == tk.TType.SHIFT_LEFT_ASSIGN) { return "<<"; }
    if (t == tk.TType.SHIFT_RIGHT_ASSIGN) { return ">>"; }
    return "";
}

fn infija(cu.Parser ptr mutable p, tk.Token op, int izq, int der) -> int {
    if (op.tipo == tk.TType.ASSIGN) {
        exige_asignable(p, op, izq, "'='");
        return asignacion(p, izq, der);
    }
    var str comp = compuesto(op.tipo);
    if (comp != "") { return expande_compuesta(p, op, izq, der, comp); }
    return binaria(p, binario(op.tipo), izq, der);
}

fn binaria(cu.Parser ptr mutable p, str operador, int izq, int der) -> int {
    var int n = cu.nodo(p, "BinaryOp", ar.linea_de(&p.arbol, izq), ar.col_de(&p.arbol, izq));
    cu.texto(p, n, "operator", operador);
    cu.hijo(p, n, "left", izq);
    cu.hijo(p, n, "right", der);
    return n;
}

fn asignacion(cu.Parser ptr mutable p, int destino, int valor) -> int {
    var int n = cu.nodo(p, "Assignment", ar.linea_de(&p.arbol, destino), ar.col_de(&p.arbol, destino));
    cu.hijo(p, n, "target", destino);
    cu.hijo(p, n, "value", valor);
    return n;
}

fn exige_asignable(cu.Parser ptr mutable p, tk.Token op, int izq, str cual) -> void {
    var str c = cu.clase(p, izq);
    if (c != "Identifier" and c != "MemberAccess" and c != "Index") {
        cu.falla("PAR012", f"el lado izquierdo de {cual} no es asignable", op.linea, op.col);
    }
}

/- `x op= v` -> `x = x op v` (y `x++` con v = 1). Es AZÚCAR: ningún nodo
   propio. El destino aparece dos veces, así que tiene que poder evaluarse
   dos veces sin efectos (sin llamadas dentro). -/
public fn expande_compuesta(cu.Parser ptr mutable p, tk.Token op, int izq, int der, str operador) -> int {
    exige_asignable(p, op, izq, "'" + op.lexema + "'");
    if (not repetible(p, izq)) {
        cu.falla("PAR012", "'" + op.lexema + "' necesita un destino que se pueda evaluar dos veces sin efectos: este tiene una llamada dentro. Escribelo completo ('x = x " + operador + " ...') para que quede claro cuantas veces se evalua",
                 op.linea, op.col);
    }
    var int copia = ar.copia(&p.arbol, izq);
    var int valor = cu.nodo(p, "BinaryOp", ar.linea_de(&p.arbol, izq), ar.col_de(&p.arbol, izq));
    cu.texto(p, valor, "operator", operador);
    cu.hijo(p, valor, "left", copia);
    cu.hijo(p, valor, "right", der);
    return asignacion(p, izq, valor);
}

public fn repetible(cu.Parser ptr p, int n) -> bool {
    var str c = cu.clase(p, n);
    if (c == "Identifier") { return true; }
    if (c == "MemberAccess") { return repetible(p, ar.hijo_llamado(&p.arbol, n, "obj")); }
    if (c == "Index") {
        var int indice = ar.hijo_llamado(&p.arbol, n, "index");
        return repetible(p, ar.hijo_llamado(&p.arbol, n, "obj"))
            and (cu.clase(p, indice) == "Literal" or repetible(p, indice));
    }
    return false;
}

// --------------------------------------------------------------------------- //
// prefijos
// --------------------------------------------------------------------------- //

public fn unaria(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.actual(p);
    if (t.tipo == tk.TType.ADDRESS) {
        cu.avanza(p);
        var int operando = unaria(p);
        var int n = cu.nodo_en(p, "AddrOf", t);
        cu.hijo(p, n, "operand", operando);
        return n;
    }
    if (t.tipo == tk.TType.NOT or t.tipo == tk.TType.MINUS or t.tipo == tk.TType.TILDE) {
        cu.avanza(p);
        var int operando = unaria(p);
        // '-' pegado a un literal numérico ES el literal negativo: es la
        // única forma de escribir el mínimo de 'int' (su opuesto no cabe).
        var str clase = ar.extra_de(&p.arbol, operando);
        if (t.tipo == tk.TType.MINUS and cu.clase(p, operando) == "Literal"
                and (clase == "int" or clase == "float")) {
            return literal(p, t, negado(cu.nombre(p, operando)), clase, "");
        }
        var int n = cu.nodo_en(p, "UnaryOp", t);
        if (t.tipo == tk.TType.NOT) { cu.texto(p, n, "operator", "not"); }
        else if (t.tipo == tk.TType.TILDE) { cu.texto(p, n, "operator", "~"); }
        else { cu.texto(p, n, "operator", "-"); }
        cu.hijo(p, n, "operand", operando);
        return n;
    }
    return postfija(p);
}

fn negado(str numero) -> str {
    if (len(numero) > 0 and numero[0] == '-') { return cu.trozo(numero, 1, len(numero)); }
    return "-" + numero;
}

/- Un literal. `crudo` es cómo se escribe su valor en el volcado; si viene
   vacío, se escribe `valor` entre comillas (texto y caracteres). -/
fn literal(cu.Parser ptr mutable p, tk.Token t, str valor, str clase, str texto) -> int {
    var int n = cu.nodo_en(p, "Literal", t);
    if (clase == "str" or clase == "char") { cu.texto(p, n, "value", texto); }
    else { cu.crudo(p, n, "value", valor); }
    cu.texto(p, n, "literal_kind", clase);
    ar.pon_nombre(&p.arbol, n, valor, clase);
    return n;
}

// --------------------------------------------------------------------------- //
// postfijos
// --------------------------------------------------------------------------- //

public fn postfija(cu.Parser ptr mutable p) -> int {
    var int e = primaria(p);
    // mientras la expresión sea un NOMBRE puro ('Nodo', 'pt.Punto'), un '{'
    // puede abrir un literal de struct y un '<' unos argumentos de tipo
    var bool nombrando = cu.clase(p, e) == "Identifier";
    var str punteado = "";
    if (nombrando) { punteado = cu.nombre(p, e); }
    while (true) {
        var tk.Token t = cu.actual(p);
        if (t.tipo == tk.TType.L_BRACE and nombrando and not p.sin_literal) {
            var vec.Vector<int> nada = vec.dynamic<int>(1);
            e = literal_struct(p, e, punteado, &nada);
            nombrando = false;
        } else if (t.tipo == tk.TType.LESS and nombrando) {
            var vec.Vector<int> args = argumentos_de_generico(p);
            if (args.len() == 0) { return e; }
            if (cu.es(p, tk.TType.L_BRACE)) {
                e = literal_struct(p, e, punteado, &args);
            } else {
                cu.avanza(p);           // el '('
                var int llamada = llamada_a(p, e);
                var int i = 0;
                while (i < args.len()) {
                    cu.hijo(p, llamada, "type_args", args.get(i));
                    i = i + 1;
                }
                e = llamada;
            }
            nombrando = false;
        } else if (t.tipo == tk.TType.DOT) {
            cu.avanza(p);
            var tk.Token miembro = cu.exige_nombre(p);
            var int n = cu.nodo(p, "MemberAccess", ar.linea_de(&p.arbol, e), ar.col_de(&p.arbol, e));
            cu.texto(p, n, "member", miembro.lexema);
            ar.pon_nombre(&p.arbol, n, miembro.lexema, "");
            cu.hijo(p, n, "obj", e);
            e = n;
            if (nombrando) { punteado = punteado + "." + miembro.lexema; }
        } else if (t.tipo == tk.TType.L_PAREN) {
            cu.avanza(p);
            e = llamada_a(p, e);
            nombrando = false;
        } else if (t.tipo == tk.TType.L_BRACKET) {
            cu.avanza(p);
            var bool previo = p.sin_literal;
            p.sin_literal = false;
            var int indice = expresion_protegida(p, previo);
            cu.exige(p, tk.TType.R_BRACKET);
            var int n = cu.nodo(p, "Index", ar.linea_de(&p.arbol, e), ar.col_de(&p.arbol, e));
            cu.hijo(p, n, "obj", e);
            cu.hijo(p, n, "index", indice);
            e = n;
            nombrando = false;
        } else {
            return e;
        }
    }
    return e;
}

/- Una expresión con los literales de struct PERMITIDOS (dentro de un
   delimitador), devolviendo `sin_literal` a `previo` pase lo que pase: si
   la expresión lanza un error, el contexto no puede quedar cambiado para
   la declaración siguiente. Es el `finally` de la V0, escrito con un
   `catch` que restaura y relanza. -/
fn expresion_protegida(cu.Parser ptr mutable p, bool previo) -> int {
    var int r = -1;
    try {
        r = expresion(p);
    } catch (e) {
        p.sin_literal = previo;
        throw e;
    };
    p.sin_literal = previo;
    return r;
}

/- Tras el '(' ya consumido: los argumentos y el ')'. -/
fn llamada_a(cu.Parser ptr mutable p, int callee) -> int {
    var int n = cu.nodo(p, "Call", ar.linea_de(&p.arbol, callee), ar.col_de(&p.arbol, callee));
    cu.hijo(p, n, "callee", callee);
    if (not cu.es(p, tk.TType.R_PAREN)) {
        var bool previo = p.sin_literal;
        p.sin_literal = false;
        cu.hijo(p, n, "args", expresion_protegida(p, false));
        while (cu.acepta(p, tk.TType.COMMA)) {
            cu.hijo(p, n, "args", expresion_protegida(p, false));
        }
        p.sin_literal = previo;
    }
    cu.exige(p, tk.TType.R_PAREN);
    return n;
}

/- `<` tipos `>` SI le sigue un '(' (una llamada) o, donde se admite, un
   '{' (un literal). Si no es eso, el cursor vuelve EXACTAMENTE donde
   estaba y devuelve un vector vacío: el '<' era una comparación. Es el
   único retroceso del parser, y nunca cruza el '>'. -/
fn argumentos_de_generico(cu.Parser ptr mutable p) -> vec.Vector<int> {
    var int inicio = p.pos;
    var vec.Vector<int> args = vec.dynamic<int>(2);
    try {
        args = ti.argumentos(p);
    } catch (cu.ErrorDeSintaxis e) {
        p.pos = inicio;
        return vec.dynamic<int>(1);
    };
    var tk.TType sigue = cu.actual(p).tipo;
    if (sigue == tk.TType.L_PAREN or (sigue == tk.TType.L_BRACE and not p.sin_literal)) {
        return args;
    }
    p.pos = inicio;
    return vec.dynamic<int>(1);
}

/- `Nombre [<tipos>] { campo: valor, ... }` (el nombre ya se leyó). -/
fn literal_struct(cu.Parser ptr mutable p, int nombre, str tipo, vec.Vector<int> ptr args) -> int {
    cu.exige(p, tk.TType.L_BRACE);
    var int n = cu.nodo(p, "StructLiteral", ar.linea_de(&p.arbol, nombre), ar.col_de(&p.arbol, nombre));
    cu.texto(p, n, "type_name", tipo);
    var str campos = "";
    var bool previo = p.sin_literal;
    p.sin_literal = false;
    while (not cu.es(p, tk.TType.R_BRACE) and not cu.al_final(p)) {
        var tk.Token campo = cu.exige_nombre(p);
        cu.exige(p, tk.TType.COLON);
        if (campos != "") { campos = campos + ","; }
        campos = campos + campo.lexema;
        cu.hijo(p, n, "values", expresion_protegida(p, false));
        if (not cu.acepta(p, tk.TType.COMMA)) { break; }
    }
    p.sin_literal = previo;
    cu.exige(p, tk.TType.R_BRACE);
    if (campos != "") { cu.crudo(p, n, "field_names", "[" + campos + "]"); }
    var int i = 0;
    while (i < args.len()) {
        cu.hijo(p, n, "type_args", args.get(i));
        i = i + 1;
    }
    return n;
}

// --------------------------------------------------------------------------- //
// primarias
// --------------------------------------------------------------------------- //

/- `.campo` dentro de un `with`: el campo de su receptor. -/
fn receiver_member(cu.Parser ptr mutable p) -> int {
    var tk.Token punto = cu.exige(p, tk.TType.DOT);
    var tk.Token nombre = cu.exige_nombre(p);
    var int receptor = -1;
    if (p.receptores.len() > 0) { receptor = p.receptores.get(p.receptores.len() - 1); }
    if (receptor < 0) {
        var str porque = "aqui no hay ninguno";
        if (p.receptores.len() > 0) { porque = "este 'with' tiene varios y no dice de cual es"; }
        cu.falla("PAR028", "'." + nombre.lexema + "' necesita un 'with' de UN valor alrededor: " + porque,
                 punto.linea, punto.col);
    }
    var int m = cu.nodo(p, "MemberAccess", punto.linea, punto.col);
    cu.texto(p, m, "member", nombre.lexema);
    ar.pon_nombre(&p.arbol, m, nombre.lexema, "");
    cu.hijo(p, m, "obj", ar.copia(&p.arbol, receptor));
    return m;
}

public fn primaria(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.actual(p);
    if (cu.es_nombre(t.tipo)) {
        cu.avanza(p);
        var int n = cu.nodo_en(p, "Identifier", t);
        cu.texto(p, n, "name", t.lexema);
        ar.pon_nombre(&p.arbol, n, t.lexema, "");
        return n;
    }
    if (t.tipo == tk.TType.DOT) { return receiver_member(p); }
    if (t.tipo == tk.TType.INT_LIT) { cu.avanza(p); return literal(p, t, cu.valor_numerico(t.lexema), "int", ""); }
    if (t.tipo == tk.TType.FLOAT_LIT) { cu.avanza(p); return literal(p, t, cu.valor_numerico(t.lexema), "float", ""); }
    if (t.tipo == tk.TType.CHAR_LIT) {
        cu.avanza(p);
        var str c = decodifica_caracter(t.lexema);
        return literal(p, t, c, "char", c);
    }
    if (t.tipo == tk.TType.TRUE) { cu.avanza(p); return literal(p, t, "true", "bool", ""); }
    if (t.tipo == tk.TType.FALSE) { cu.avanza(p); return literal(p, t, "false", "bool", ""); }
    if (t.tipo == tk.TType.NULL) { cu.avanza(p); return literal(p, t, "null", "null", ""); }
    if (t.tipo == tk.TType.STRING_LIT) { cu.avanza(p); return cadena(p, t); }
    if (t.tipo == tk.TType.L_PAREN) {
        cu.avanza(p);
        var bool previo = p.sin_literal;
        p.sin_literal = false;
        var int e = expresion_protegida(p, previo);
        cu.exige(p, tk.TType.R_PAREN);
        return e;
    }
    if (t.tipo == tk.TType.SIZEOF) {
        cu.avanza(p);
        cu.exige(p, tk.TType.L_PAREN);
        var int tipo = ti.tipo(p);
        cu.exige(p, tk.TType.R_PAREN);
        var int n = cu.nodo_en(p, "SizeofExpr", t);
        cu.hijo(p, n, "type", tipo);
        return n;
    }
    if (t.tipo == tk.TType.CAST) {
        cu.avanza(p);
        var vec.Vector<int> args = ti.argumentos(p);
        if (args.len() != 1) {
            cu.falla("PAR012", f"'cast' toma exactamente un argumento de tipo, recibe {args.len()}",
                     t.linea, t.col);
        }
        cu.exige(p, tk.TType.L_PAREN);
        var int valor = expresion(p);
        cu.exige(p, tk.TType.R_PAREN);
        var int n = cu.nodo_en(p, "CastExpr", t);
        cu.hijo(p, n, "type", args.get(0));
        cu.hijo(p, n, "value", valor);
        return n;
    }
    if (t.tipo == tk.TType.MOVE) {
        cu.avanza(p);
        var int operando = unaria(p);
        var int n = cu.nodo_en(p, "MoveExpr", t);
        cu.hijo(p, n, "operand", operando);
        return n;
    }
    cu.falla("PAR012", f"token inesperado en expresion: {tk.nombre_de(t.tipo)}", t.linea, t.col);
    return -1;
}

// --------------------------------------------------------------------------- //
// cadenas y caracteres: el token trae el texto crudo; aquí se resuelve
// --------------------------------------------------------------------------- //

fn escape(char c) -> str {
    if (c == 'n') { return "\n"; }
    if (c == 't') { return "\t"; }
    if (c == 'r') { return "\r"; }
    if (c == '0') { return "\0"; }
    return cast<str>(c);        // '\\', '"', '\''
}

/- `'x'` o `'\n'` -> el carácter. -/
fn decodifica_caracter(str lexema) -> str {
    if (lexema[1] == '\\') { return escape(lexema[2]); }
    return cast<str>(lexema[1]);
}

/- Un STRING_LIT: uno o varios literales seguidos ("a" f"b{x}"). Sin
   interpolaciones es un `Literal` con el texto ya resuelto; con alguna, una
   `InterpolatedString` cuyas partes son trozos de texto y expresiones. Los
   trozos de texto contiguos se funden, también a través de literales. -/
fn cadena(cu.Parser ptr mutable p, tk.Token t) -> int {
    var int n = cu.nodo_en(p, "InterpolatedString", t);
    var bool interpolada = false;
    var str texto = "";
    var str s = t.lexema;
    var int i = 0;
    var int literal_n = 0;
    while (i < len(s)) {
        var int inicio_col = columna_de_literal(t, literal_n);
        var int inicio = i;
        var bool con_f = s[i] == 'f';
        if (con_f) { i = i + 1; }
        i = i + 1;              // la comilla de apertura
        while (s[i] != '"') {
            var char c = s[i];
            if (c == '\\') {
                texto = texto + escape(s[i + 1]);
                i = i + 2;
            } else if (con_f and c == '{' and s[i + 1] == '{') {
                texto = texto + "{";
                i = i + 2;
            } else if (con_f and c == '}' and s[i + 1] == '}') {
                texto = texto + "}";
                i = i + 2;
            } else if (con_f and c == '{') {
                var int j = i + 1;
                var int prof = 1;
                while (prof > 0) {
                    if (s[j] == '{') { prof = prof + 1; }
                    if (s[j] == '}') { prof = prof - 1; }
                    if (prof > 0) { j = j + 1; }
                }
                if (texto != "") { parte_texto(p, n, texto); texto = ""; }
                var int col = inicio_col + (i + 1 - inicio);
                cu.hijo(p, n, "parts", interpolacion(p, cu.trozo(s, i + 1, j), t.linea, col));
                interpolada = true;
                i = j + 1;
            } else {
                texto = texto + cast<str>(c);
                i = i + 1;
            }
        }
        i = i + 2;              // la comilla de cierre y el espacio que une
        literal_n = literal_n + 1;
    }
    if (not interpolada) {
        return literal(p, t, texto, "str", texto);
    }
    if (texto != "") { parte_texto(p, n, texto); }
    return n;
}

/- Solo el TEXTO de un STRING_LIT, sin las interpolaciones (el nombre de
   un `test "..."`; la V0 usa `StringValue.flat()`). -/
public fn plano(tk.Token t) -> str {
    var str s = t.lexema;
    var str texto = "";
    var int i = 0;
    while (i < len(s)) {
        var bool con_f = s[i] == 'f';
        if (con_f) { i = i + 1; }
        i = i + 1;
        while (s[i] != '"') {
            var char c = s[i];
            if (c == '\\') {
                texto = texto + escape(s[i + 1]);
                i = i + 2;
            } else if (con_f and (c == '{' or c == '}') and s[i + 1] == c) {
                texto = texto + cast<str>(c);
                i = i + 2;
            } else if (con_f and c == '{') {
                var int prof = 1;
                i = i + 1;
                while (prof > 0) {
                    if (s[i] == '{') { prof = prof + 1; }
                    if (s[i] == '}') { prof = prof - 1; }
                    i = i + 1;
                }
            } else {
                texto = texto + cast<str>(c);
                i = i + 1;
            }
        }
        i = i + 2;
    }
    return texto;
}

/- La columna donde empieza el literal número `k` de un token (0 = el
   primero, que empieza donde el token). -/
fn columna_de_literal(tk.Token t, int k) -> int {
    if (k == 0 or t.inicios == "") { return t.col; }
    var int actual = 0;
    var str numero = "";
    var int i = 0;
    while (i < len(t.inicios)) {
        if (t.inicios[i] == ';') {
            if (actual == k) { return cu.entero(numero); }
            actual = actual + 1;
            numero = "";
        } else {
            numero = numero + cast<str>(t.inicios[i]);
        }
        i = i + 1;
    }
    return cu.entero(numero);
}

fn parte_texto(cu.Parser ptr mutable p, int n, str texto) -> void {
    var int h = cu.nodo(p, "", 0, 0);
    ar.pon_nombre(&p.arbol, h, ar.cita(texto), "");
    cu.hijo(p, n, "parts", h);
}

/- El texto de un `{expr}` como una expresión completa. Se tokeniza aparte
   y se parsea en una VENTANA añadida al final de los tokens (ver
   `cursor`); todo su árbol se reubica en la posición del `{` en el
   archivo, como hace la V0. -/
fn interpolacion(cu.Parser ptr mutable p, str crudo, int linea, int col) -> int {
    var PartesDeFormato f = separar_formato(sin_bordes(crudo));
    if (f.con_spec and not formato_valido(f.spec)) {
        cu.falla("PAR012", f"interpolacion invalida: el formato ':{f.spec}' no se entiende; es [0][ancho][.precision][tipo], con tipo d, x, X, b, o o f", linea, col);
    }
    var vec.Vector<str> descartados = vec.dynamic<str>(1);
    var vec.Vector<tk.Token> sub = lx.tokenizar(f.texto, &descartados);
    var int pos_previa = p.pos;
    var int fin_previo = p.fin;
    var bool literal_previo = p.sin_literal;
    var int bucles_previos = p.bucles;
    p.pos = p.toks.len();
    var int i = 0;
    while (i < sub.len()) {
        p.toks.push(sub.get(i));
        i = i + 1;
    }
    p.fin = p.toks.len() - 1;
    p.sin_literal = false;
    p.bucles = 0;
    var int e = -1;
    var bool sobra = false;
    try {
        e = expresion(p);
        sobra = not cu.al_final(p);
    } catch (cu.ErrorDeSintaxis err) {
        p.pos = pos_previa;
        p.fin = fin_previo;
        p.sin_literal = literal_previo;
        p.bucles = bucles_previos;
        cu.falla("PAR012", "interpolacion invalida: " + err.mensaje, linea, col);
    };
    p.pos = pos_previa;
    p.fin = fin_previo;
    p.sin_literal = literal_previo;
    p.bucles = bucles_previos;
    if (sobra) {
        cu.falla("PAR012", "la interpolacion contiene mas de una expresion", linea, col);
    }
    ar.reubica(&p.arbol, e, linea, col);
    if (f.conversion != "" or f.spec != "") {
        var int n = cu.nodo(p, "FormattedValue", linea, col);
        cu.hijo(p, n, "value", e);
        if (f.conversion != "") { cu.texto(p, n, "conversion", f.conversion); }
        if (f.spec != "") { cu.texto(p, n, "format_spec", f.spec); }
        return n;
    }
    return e;
}

/- `{x!r:>8}` partido: la expresión, la conversión (`r` o nada) y el
   especificador (`con_spec` dice si había `:`). -/
struct { str texto; str conversion; str spec; bool con_spec; } PartesDeFormato;

/- El `!` y el `:` se buscan FUERA de paréntesis, llaves, corchetes y
   literales, como la V0: dentro de una interpolación puede haber un literal
   de struct (`g{k: 1}`), una cadena con dos puntos o un `!=`. -/
fn separar_formato(str s) -> PartesDeFormato {
    var int prof = 0;
    var int i = 0;
    var int n = len(s);
    while (i < n) {
        var char c = s[i];
        if (c == '"' or c == '\'') {
            i = i + 1;
            while (i < n and s[i] != c) {
                if (s[i] == '\\') { i = i + 2; } else { i = i + 1; }
            }
            i = i + 1;
        } else {
            if (c == '(' or c == '[' or c == '{') {
                prof = prof + 1;
            } else if (c == ')' or c == ']' or c == '}') {
                prof = prof - 1;
            } else if (prof == 0 and c == '!' and i + 1 < n and s[i + 1] == 'r'
                       and (i + 2 == n or s[i + 2] == ':')) {
                if (i + 2 < n) {
                    return PartesDeFormato{ texto: cu.trozo(s, 0, i), conversion: "r",
                                            spec: cu.trozo(s, i + 3, n), con_spec: true };
                }
                return PartesDeFormato{ texto: cu.trozo(s, 0, i), conversion: "r",
                                        spec: "", con_spec: false };
            } else if (prof == 0 and c == ':') {
                return PartesDeFormato{ texto: cu.trozo(s, 0, i), conversion: "",
                                        spec: cu.trozo(s, i + 1, n), con_spec: true };
            }
            i = i + 1;
        }
    }
    return PartesDeFormato{ texto: s, conversion: "", spec: "", con_spec: false };
}

fn es_cifra(char c) -> bool {
    return c >= '0' and c <= '9';
}

/- `[0][ancho][.precision][tipo]`, tipo d, x, X, b, o o f: la sintaxis (que
   el valor admita ese formato lo decide la Semántica). -/
fn formato_valido(str f) -> bool {
    var int i = 0;
    var int n = len(f);
    if (i < n and f[i] == '0') { i = i + 1; }
    if (i < n and f[i] >= '1' and f[i] <= '9') {
        i = i + 1;
        while (i < n and es_cifra(f[i])) { i = i + 1; }
    }
    if (i < n and f[i] == '.') {
        i = i + 1;
        if (not (i < n and es_cifra(f[i]))) { return false; }
        while (i < n and es_cifra(f[i])) { i = i + 1; }
    }
    if (i < n and (f[i] == 'd' or f[i] == 'x' or f[i] == 'X' or f[i] == 'b'
                   or f[i] == 'o' or f[i] == 'f')) {
        i = i + 1;
    }
    return i == n;
}

/- El texto sin los espacios de los bordes (la V0 hace `.strip()`). -/
fn sin_bordes(str s) -> str {
    var int a = 0;
    var int b = len(s);
    while (a < b and (s[a] == ' ' or s[a] == '\t')) { a = a + 1; }
    while (b > a and (s[b - 1] == ' ' or s[b - 1] == '\t')) { b = b - 1; }
    return cu.trozo(s, a, b);
}

#export as expresiones
