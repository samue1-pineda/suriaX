/- frontend.sentencias — sentencias y bloques (`V0/.../grammar/statements.py`,
   `block.py`, `control_flow.py`, `errors.py`, `memory.py`).

     block     = "{" { statement } "}" [ ";" ]
     statement = var_decl | type_decl | if | while | match | return | break
               | continue | move | free | throw | try | expr_stmt
     var_decl  = [ "const" | "var" ] type NAME [ "[" expr "]" ] [ "=" expr ] ";"

 Una sentencia que empieza por un NOMBRE es ambigua entre tres formas (una
 declaración con tipo nominal, un alias de import y una expresión); se
 decide MIRANDO los tokens siguientes, sin consumirlos ni retroceder.
-/

#import frontend.tokens as tk
#import frontend.cursor as cu
#import frontend.tipos as ti
#import frontend.expresiones as ex
#import frontend.directivas as di
#import frontend.arbol as ar
#import array.vector as vec

public fn bloque(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.L_BRACE);
    var int n = cu.nodo_en(p, "Block", t);
    while (not cu.es(p, tk.TType.R_BRACE) and not cu.al_final(p)) {
        cu.hijo(p, n, "statements", sentencia(p, ""));
    }
    cu.exige(p, tk.TType.R_BRACE);
    cu.acepta(p, tk.TType.SEMICOLON);   // ';' opcional tras '}'
    return n;
}

/- `visibilidad` solo llega en un binding de NIVEL SUPERIOR
   (`public const int MAX = 10;`); en cualquier otra sentencia es un error. -/
public fn sentencia(cu.Parser ptr mutable p, str visibilidad) -> int {
    var tk.Token t = cu.actual(p);
    var tk.TType tipo = t.tipo;
    if (cu.es_nombre(tipo)) {
        if (parece_alias_de_import(p)) { return alias_de_import(p, t, "", visibilidad); }
        if (parece_declaracion(p)) { return declaracion(p, visibilidad); }
        return solo_visible_en_declaracion(p, t, expresion_sentencia(p), visibilidad);
    }
    if (tipo == tk.TType.CONST or tipo == tk.TType.VAR or tipo == tk.TType.VOID
            or tipo == tk.TType.BOOL or tipo == tk.TType.INT or tipo == tk.TType.FLOAT
            or tipo == tk.TType.CHAR or tipo == tk.TType.STR or tipo == tk.TType.ERRORTYPE
            or tipo == tk.TType.BYTE) {
        return declaracion(p, visibilidad);
    }
    if (tipo == tk.TType.TYPE) { return declaracion_de_tipo(p, t, "", visibilidad); }
    var int n = -1;
    if (tipo == tk.TType.MUTABLE) {
        cu.falla("PAR003", "'mutable' ya no califica variables: usa 'var' para un binding mutable ('var int x = 10;'); 'mutable' aplica a punteros ('T ptr mutable') y a regiones ('mutable region r')",
                 t.linea, t.col);
    } else if (tipo == tk.TType.POINTER) {
        cu.falla("PAR003", "'ptr' es un sufijo postfijo: el tipo va primero ('int ptr p = &x;', no 'ptr int p = &x;')",
                 t.linea, t.col);
    } else if (tipo == tk.TType.PUBLIC or tipo == tk.TType.PRIVATE or tipo == tk.TType.INTERNAL) {
        cu.falla("PAR013", "la visibilidad (public/private/internal) solo aplica a declaraciones de nivel superior, no dentro de un bloque",
                 t.linea, t.col);
    } else if (tipo == tk.TType.HOOK or tipo == tk.TType.DUNDER_KW) {
        cu.falla("PAR003", f"'{t.lexema}' solo puede preceder a 'fn' en una declaracion de nivel superior ('hook fn __free__(...)')",
                 t.linea, t.col);
    } else if (tipo == tk.TType.THROW) { n = lanza(p); }
    else if (tipo == tk.TType.TRY) { n = intenta(p); }
    else if (tipo == tk.TType.WITH) { n = with_stmt(p); }
    else if (tipo == tk.TType.IF) { n = si(p); }
    else if (tipo == tk.TType.WHILE) { n = mientras(p); }
    else if (tipo == tk.TType.MATCH) { n = segun(p); }
    else if (tipo == tk.TType.RETURN) { n = retorna(p); }
    else if (tipo == tk.TType.BREAK) { n = corta(p, "BreakStmt", "'break' fuera de un bucle"); }
    else if (tipo == tk.TType.CONTINUE) { n = corta(p, "ContinueStmt", "'continue' fuera de un bucle"); }
    else if (tipo == tk.TType.MOVE) { n = con_objetivo(p, "MoveStmt"); }
    else if (tipo == tk.TType.FREE) { n = con_objetivo(p, "FreeStmt"); }
    else { n = expresion_sentencia(p); }
    return solo_visible_en_declaracion(p, t, n, visibilidad);
}

fn solo_visible_en_declaracion(cu.Parser ptr mutable p, tk.Token t, int n, str visibilidad) -> int {
    if (visibilidad != "") {
        cu.falla("PAR013", "la visibilidad (public/private/internal) solo aplica a declaraciones (fn, struct, enum o un binding)",
                 t.linea, t.col);
    }
    return n;
}

// --------------------------------------------------------------------------- //
// declaraciones de variables y de tipos
// --------------------------------------------------------------------------- //

/- ¿El nombre en curso empieza un TIPO? Sí si, saltando la ruta (`a.b.c`)
   y los sufijos (`?`, `ptr [mutable]`), viene OTRO nombre. -/
fn parece_declaracion(cu.Parser ptr p) -> bool {
    var int d = 1;
    while (cu.es_en(p, d, tk.TType.DOT) and cu.es_nombre(cu.mira(p, d + 1).tipo)) { d = d + 2; }
    while (true) {
        var tk.TType t = cu.mira(p, d).tipo;
        if (t == tk.TType.NULLABLE) {
            d = d + 1;
        } else if (t == tk.TType.POINTER) {
            d = d + 1;
            if (cu.es_en(p, d, tk.TType.MUTABLE)) { d = d + 1; }
        } else {
            return cu.es_nombre(t);
        }
    }
    return false;
}

fn parece_alias_de_import(cu.Parser ptr p) -> bool {
    if (not cu.es(p, tk.TType.IDENTIFIER) or not cu.es_en(p, 1, tk.TType.ASSIGN)
            or not cu.es_en(p, 2, tk.TType.DIRECTIVE)) { return false; }
    var str d = cu.sin_prefijo(cu.mira(p, 2));
    return d == "import" or d == "from";
}

fn alias_de_import(cu.Parser ptr mutable p, tk.Token inicio, str calificador, str visibilidad) -> int {
    var tk.Token nombre = cu.exige(p, tk.TType.IDENTIFIER);
    cu.exige(p, tk.TType.ASSIGN);
    var int fuente = -1;
    if (cu.sin_prefijo(cu.actual(p)) == "import") { fuente = di.importa(p); }
    else { fuente = di.desde(p); }
    var int n = cu.nodo_en(p, "ImportBinding", inicio);
    if (calificador != "") { cu.texto(p, n, "qualifier", calificador); }
    cu.texto(p, n, "name", nombre.lexema);
    if (visibilidad != "") { cu.texto(p, n, "visibility", visibilidad); }
    cu.hijo(p, n, "source", fuente);
    return n;
}

public fn declaracion(cu.Parser ptr mutable p, str visibilidad) -> int {
    var tk.Token inicio = cu.actual(p);
    var str calificador = "";
    if (cu.acepta(p, tk.TType.CONST)) { calificador = "const"; }
    else if (cu.acepta(p, tk.TType.VAR)) { calificador = "var"; }
    if (parece_alias_de_import(p)) { return alias_de_import(p, inicio, calificador, visibilidad); }
    if (cu.es(p, tk.TType.TYPE)) { return declaracion_de_tipo(p, inicio, calificador, visibilidad); }
    var int tipo = ti.tipo(p);
    if (cu.es(p, tk.TType.ASSIGN) and cu.clase(p, tipo) == "NominalTypeExpr") {
        var str q = calificador;
        if (q == "") { q = "var"; }
        var str nombre = cu.nombre(p, tipo);
        cu.falla("PAR023", f"falta el tipo de '{nombre}': en suriaX un binding se anota siempre. Escribe '{q} <tipo> {nombre} = ...' (no hay inferencia de tipos: el tipo de una variable se lee sin ejecutar el compilador en la cabeza)",
                 ar.linea_de(&p.arbol, tipo), ar.col_de(&p.arbol, tipo));
    }
    var int contenedor = contenedor_tras_elemento(p);
    var tk.Token nombre = cu.exige_nombre(p);
    var int capacidad = -1;
    if (cu.acepta(p, tk.TType.L_BRACKET)) {
        capacidad = ex.expresion(p);
        cu.exige(p, tk.TType.R_BRACKET);
    }
    var int valor = -1;
    if (cu.acepta(p, tk.TType.ASSIGN)) { valor = ex.expresion(p); }
    cu.exige(p, tk.TType.SEMICOLON);
    if (contenedor >= 0 or capacidad >= 0) {
        return declaracion_de_contenedor(p, inicio, calificador, tipo, contenedor, nombre,
                                         capacidad, valor, visibilidad);
    }
    return var_decl(p, inicio, calificador, tipo, nombre.lexema, valor, visibilidad, -1);
}

fn var_decl(cu.Parser ptr mutable p, tk.Token inicio, str calificador, int tipo, str nombre,
            int valor, str visibilidad, int capacidad) -> int {
    var int n = cu.nodo_en(p, "VarDecl", inicio);
    if (calificador != "") { cu.texto(p, n, "qualifier", calificador); }
    cu.texto(p, n, "name", nombre);
    if (visibilidad != "") { cu.texto(p, n, "visibility", visibilidad); }
    cu.hijo(p, n, "type", tipo);
    cu.hijo(p, n, "value", valor);
    cu.hijo(p, n, "capacity", capacidad);
    return n;
}

fn texto_de_tipo(cu.Parser ptr p, int t) -> str {
    if (cu.clase(p, t) == "NominalTypeExpr") { return cu.nombre(p, t); }
    return "<tipo>";
}

/- El CONTENEDOR de `int vec.Vector v[8];`, o -1. Si tras el primer tipo
   viene otro tipo y luego un nombre, era esa forma; si no, el cursor vuelve
   exactamente donde estaba. -/
fn contenedor_tras_elemento(cu.Parser ptr mutable p) -> int {
    if (not cu.es(p, tk.TType.IDENTIFIER)) { return -1; }
    var int inicio = p.pos;
    var int c = -1;
    try {
        c = ti.tipo(p);
    } catch (cu.ErrorDeSintaxis e) {
        p.pos = inicio;
        return -1;
    };
    if (cu.es_nombre(cu.actual(p).tipo)) { return c; }
    if (cu.es(p, tk.TType.L_BRACKET)) {
        var tk.Token t = cu.actual(p);
        var str texto = texto_de_tipo(p, c);
        cu.falla("PAR023", f"falta el NOMBRE de la variable: '{texto}' es el contenedor y '[...]' su capacidad, pero no dice como se llama. Escribe '<tipo> {texto} <nombre>[...]'",
                 t.linea, t.col);
    }
    p.pos = inicio;
    return -1;
}

/- `int vec.Vector v[8];` -> `var vec.Vector<int> v = vec.make<int>(8);`.
   Es AZÚCAR: se deshace aquí y nadie más se entera de que existe. -/
fn declaracion_de_contenedor(cu.Parser ptr mutable p, tk.Token inicio, str calificador,
                             int elemento, int contenedor, tk.Token nombre, int capacidad,
                             int valor, str visibilidad) -> int {
    if (contenedor < 0) {
        cu.falla("PAR023", f"'{nombre.lexema}[...]' reserva espacio, pero no dice EN QUE: escribe el contenedor entre el tipo del elemento y el nombre ('{texto_de_tipo(p, elemento)} vec.Vector {nombre.lexema}[...]')",
                 nombre.linea, nombre.col);
    }
    if (cu.clase(p, contenedor) != "NominalTypeExpr") {
        cu.falla("PAR023", "el contenedor de una declaracion con '[...]' tiene que ser un tipo con nombre ('vec.Vector'), no un puntero ni un nullable",
                 ar.linea_de(&p.arbol, contenedor), ar.col_de(&p.arbol, contenedor));
    }
    var str nombre_contenedor = cu.nombre(p, contenedor);
    var int tipo = cu.nodo(p, "NominalTypeExpr", ar.linea_de(&p.arbol, contenedor),
                           ar.col_de(&p.arbol, contenedor));
    cu.texto(p, tipo, "name", nombre_contenedor);
    ar.pon_nombre(&p.arbol, tipo, nombre_contenedor, "");
    if (valor < 0) {
        if (capacidad < 0) {
            cu.falla("PAR023", f"'{nombre.lexema}' declara un contenedor sin capacidad ni valor: escribe cuantos espacios reserva ('{nombre.lexema}[8]') o inicializalo con '='",
                     nombre.linea, nombre.col);
        }
        valor = llamada_al_constructor(p, nombre_contenedor, ar.copia(&p.arbol, elemento),
                                       ar.copia(&p.arbol, capacidad), nombre.linea, nombre.col);
    }
    cu.hijo(p, tipo, "args", elemento);
    return var_decl(p, inicio, calificador, tipo, nombre.lexema, valor, visibilidad, capacidad);
}

/- `vec.Vector` -> `vec.make<elemento>(capacidad)`. -/
fn llamada_al_constructor(cu.Parser ptr mutable p, str contenedor, int elemento,
                          int capacidad, int linea, int col) -> int {
    var int punto = -1;
    var int i = 0;
    while (i < len(contenedor)) {
        if (contenedor[i] == '.') { punto = i; }
        i = i + 1;
    }
    var int make = cu.nodo(p, "Identifier", linea, col);
    cu.texto(p, make, "name", "make");
    var int callee = make;
    if (punto >= 0) {
        var int base = cu.nodo(p, "Identifier", linea, col);
        cu.texto(p, base, "name", cu.trozo(contenedor, 0, punto));
        callee = cu.nodo(p, "MemberAccess", linea, col);
        cu.texto(p, callee, "member", "make");
        cu.hijo(p, callee, "obj", base);
    }
    var int n = cu.nodo(p, "Call", linea, col);
    cu.hijo(p, n, "callee", callee);
    cu.hijo(p, n, "args", capacidad);
    cu.hijo(p, n, "type_args", elemento);
    return n;
}

/- `[const|var] type Nombre [<T>] [= expr];` — un tipo nominal opaco. -/
public fn declaracion_de_tipo(cu.Parser ptr mutable p, tk.Token inicio, str calificador,
                              str visibilidad) -> int {
    cu.exige(p, tk.TType.TYPE);
    var tk.Token nombre = cu.exige_nombre(p);
    var str parametros = ti.parametros(p);
    var int valor = -1;
    if (cu.acepta(p, tk.TType.ASSIGN)) { valor = ex.expresion(p); }
    cu.exige(p, tk.TType.SEMICOLON);
    var int n = cu.nodo_en(p, "TypeDecl", inicio);
    if (calificador != "") { cu.texto(p, n, "qualifier", calificador); }
    cu.texto(p, n, "name", nombre.lexema);
    if (visibilidad != "") { cu.texto(p, n, "visibility", visibilidad); }
    if (parametros != "") { cu.crudo(p, n, "type_params", parametros); }
    cu.hijo(p, n, "value", valor);
    return n;
}

/- `expr;` — y `x++;`/`x--;`, que son SENTENCIA (azúcar de `x = x + 1`). -/
fn expresion_sentencia(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.actual(p);
    var int e = ex.expresion(p);
    var tk.Token op = cu.actual(p);
    if (op.tipo == tk.TType.INCREMENT or op.tipo == tk.TType.DECREMENT) {
        cu.avanza(p);
        var int uno = cu.nodo_en(p, "Literal", op);
        cu.crudo(p, uno, "value", "1");
        cu.texto(p, uno, "literal_kind", "int");
        ar.pon_nombre(&p.arbol, uno, "1", "int");
        var str paso = "+";
        if (op.tipo == tk.TType.DECREMENT) { paso = "-"; }
        e = ex.expande_compuesta(p, op, e, uno, paso);
    }
    cu.exige(p, tk.TType.SEMICOLON);
    var int n = cu.nodo_en(p, "ExprStmt", t);
    cu.hijo(p, n, "expr", e);
    return n;
}

// --------------------------------------------------------------------------- //
// control de flujo
// --------------------------------------------------------------------------- //

fn condicion(cu.Parser ptr mutable p) -> int {
    cu.exige(p, tk.TType.L_PAREN);
    var int c = ex.expresion(p);
    cu.exige(p, tk.TType.R_PAREN);
    return c;
}

fn si(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.IF);
    var int c = condicion(p);
    var int entonces = bloque(p);
    var int sino = -1;
    if (cu.acepta(p, tk.TType.ELSE)) {
        if (cu.es(p, tk.TType.IF)) { sino = si(p); }
        else { sino = bloque(p); }
    }
    var int n = cu.nodo_en(p, "IfStmt", t);
    cu.hijo(p, n, "condition", c);
    cu.hijo(p, n, "then_block", entonces);
    cu.hijo(p, n, "else_branch", sino);
    return n;
}

fn mientras(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.WHILE);
    var int c = condicion(p);
    p.bucles = p.bucles + 1;
    var int cuerpo = bloque(p);
    p.bucles = p.bucles - 1;
    var int n = cu.nodo_en(p, "WhileStmt", t);
    cu.hijo(p, n, "condition", c);
    cu.hijo(p, n, "body", cuerpo);
    return n;
}

fn segun(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.MATCH);
    var int sujeto = condicion(p);
    cu.exige(p, tk.TType.L_BRACE);
    var int n = cu.nodo_en(p, "MatchStmt", t);
    cu.hijo(p, n, "subject", sujeto);
    while (cu.es(p, tk.TType.CASE)) { cu.hijo(p, n, "cases", rama(p)); }
    cu.exige(p, tk.TType.R_BRACE);
    cu.acepta(p, tk.TType.SEMICOLON);
    return n;
}

/- `case patron: sentencia` o `case patron { ... }`. Durante el patrón, un
   '{' abre el CUERPO de la rama, no un literal de struct. -/
fn rama(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.CASE);
    var bool previo = p.sin_literal;
    p.sin_literal = true;
    var int patron = ex.expresion(p);
    p.sin_literal = previo;
    if (cu.es(p, tk.TType.COLON) and cu.es_en(p, 1, tk.TType.L_BRACE)) { cu.avanza(p); }
    var int cuerpo = -1;
    if (cu.es(p, tk.TType.L_BRACE)) {
        cuerpo = bloque(p);
    } else {
        cu.exige(p, tk.TType.COLON);
        cuerpo = sentencia(p, "");
    }
    var int n = cu.nodo_en(p, "CaseArm", t);
    cu.hijo(p, n, "pattern", patron);
    cu.hijo(p, n, "body", cuerpo);
    return n;
}

fn retorna(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.RETURN);
    if (p.en_finally != -1) {
        cu.falla("PAR027", "'return' dentro de un 'finally': reemplazaria la salida que ya estaba en curso", t.linea, t.col);
    }
    var int valor = -1;
    if (not cu.es(p, tk.TType.SEMICOLON)) { valor = ex.expresion(p); }
    cu.exige(p, tk.TType.SEMICOLON);
    var int n = cu.nodo_en(p, "ReturnStmt", t);
    cu.hijo(p, n, "value", valor);
    return n;
}

/- `break;` o `continue;` — fuera de un bucle es un error. -/
fn corta(cu.Parser ptr mutable p, str clase, str mensaje) -> int {
    var tk.Token t = cu.avanza(p);
    if (p.bucles == 0) { cu.falla("PAR013", mensaje, t.linea, t.col); }
    if (p.en_finally == p.bucles) {
        cu.falla("PAR027", "salto que sale de un 'finally'", t.linea, t.col);
    }
    cu.exige(p, tk.TType.SEMICOLON);
    return cu.nodo_en(p, clase, t);
}

/- `move expr;` y `free expr;`. -/
fn con_objetivo(cu.Parser ptr mutable p, str clase) -> int {
    var tk.Token t = cu.avanza(p);
    var int objetivo = ex.expresion(p);
    cu.exige(p, tk.TType.SEMICOLON);
    var int n = cu.nodo_en(p, clase, t);
    cu.hijo(p, n, "target", objetivo);
    return n;
}

// --------------------------------------------------------------------------- //
// excepciones
// --------------------------------------------------------------------------- //

fn lanza(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.THROW);
    var int valor = ex.expresion(p);
    cu.exige(p, tk.TType.SEMICOLON);
    var int n = cu.nodo_en(p, "ThrowStmt", t);
    cu.hijo(p, n, "value", valor);
    return n;
}

fn intenta(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.TRY);
    var int protegido = bloque(p);
    var int n = cu.nodo_en(p, "TryStmt", t);
    cu.hijo(p, n, "try_block", protegido);
    var bool con_catch = false;
    while (cu.es(p, tk.TType.CATCH)) {
        cu.hijo(p, n, "catches", atrapa(p));
        con_catch = true;
    }
    var int final = -1;
    if (cu.acepta(p, tk.TType.FINALLY)) {
        // anidado: se guarda el de afuera y se repone al salir
        var int previo = p.en_finally;
        p.en_finally = p.bucles;
        final = bloque(p);
        p.en_finally = previo;
    }
    // un 'try' solo no hace nada: el error es el de siempre (falta el catch)
    if (not con_catch and final == -1) { cu.exige(p, tk.TType.CATCH); }
    cu.hijo(p, n, "finally_block", final);
    cu.acepta(p, tk.TType.SEMICOLON);
    return n;
}

// --------------------------------------------------------------------------- //
// with
// --------------------------------------------------------------------------- //

/- `with`: un recurso, un guardian o un receptor con ambito (la gramatica y
   el porque, en V0/src/frontend/parser/grammar/with_stmt.py). Es AZUCAR:
   sale un Block con las declaraciones y, dentro, el cuerpo. -/
fn with_stmt(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.WITH);
    var int n = cu.nodo_en(p, "Block", t);
    var int receptor = -1;
    if (cu.acepta(p, tk.TType.L_PAREN)) {
        receptor = with_item(p, n);
        while (cu.acepta(p, tk.TType.COMMA)) {
            with_item(p, n);
            receptor = -1;   // con varios, '.campo' no diria de cual
        }
        cu.exige(p, tk.TType.R_PAREN);
    } else {
        receptor = with_call_form(p, n);
    }
    p.receptores.push(receptor);
    var int cuerpo = bloque(p);
    p.receptores.pop();
    cu.hijo(p, n, "statements", cuerpo);
    return n;
}

fn identifier(cu.Parser ptr mutable p, int linea, int col, str nombre) -> int {
    var int n = cu.nodo(p, "Identifier", linea, col);
    cu.texto(p, n, "name", nombre);
    ar.pon_nombre(&p.arbol, n, nombre, "");
    return n;
}

/- Un valor del `with`. Agrega su declaracion (si tiene) al bloque y
   devuelve el receptor de `.campo`. -/
fn with_item(cu.Parser ptr mutable p, int n) -> int {
    var tk.Token inicio = cu.actual(p);
    if (cu.es(p, tk.TType.VAR) or cu.es(p, tk.TType.CONST)) {
        var tk.Token q = cu.avanza(p);
        var int tipo = ti.tipo(p);
        var tk.Token nombre = cu.exige_nombre(p);
        cu.exige(p, tk.TType.ASSIGN);
        var int valor = ex.expresion(p);
        cu.hijo(p, n, "statements", var_decl(p, inicio, q.lexema, tipo, nombre.lexema, valor, "", -1));
        return identifier(p, nombre.linea, nombre.col, nombre.lexema);
    }
    var int valor = ex.expresion(p);
    // un LUGAR: el receptor es el lugar mismo, y nadie nuevo es su dueño
    if (ex.repetible(p, valor)) { return valor; }
    // un TEMPORAL: vive hasta el final del bloque con un nombre imposible
    p.guardianes = p.guardianes + 1;
    var str nombre = f"with#{p.guardianes}";
    var int d = var_decl(p, inicio, "var", -1, nombre, valor, "", -1);
    cu.crudo(p, d, "inferido", "true");
    cu.hijo(p, n, "statements", d);
    return identifier(p, inicio.linea, inicio.col, nombre);
}

/- `open(var File f, "x.txt", "w")` -> `var File f = open("x.txt", "w")`. -/
fn with_call_form(cu.Parser ptr mutable p, int n) -> int {
    var tk.Token inicio = cu.actual(p);
    var tk.Token primero = cu.exige_nombre(p);
    var int callee = identifier(p, primero.linea, primero.col, primero.lexema);
    while (cu.acepta(p, tk.TType.DOT)) {
        var tk.Token parte = cu.exige_nombre(p);
        var int m = cu.nodo(p, "MemberAccess", primero.linea, primero.col);
        cu.texto(p, m, "member", parte.lexema);
        ar.pon_nombre(&p.arbol, m, parte.lexema, "");
        cu.hijo(p, m, "obj", callee);
        callee = m;
    }
    cu.exige(p, tk.TType.L_PAREN);
    if (not (cu.es(p, tk.TType.VAR) or cu.es(p, tk.TType.CONST))) {
        var tk.Token a = cu.actual(p);
        cu.falla("PAR003", "'with nombre(...)' declara su resultado en el primer argumento ('with open(var File f, \"x.txt\", \"r\") { }'); sin declaracion, escribe 'with (expresion) { }'",
                 a.linea, a.col);
    }
    var tk.Token q = cu.avanza(p);
    var int tipo = ti.tipo(p);
    var tk.Token nombre = cu.exige_nombre(p);
    var int llamada = cu.nodo(p, "Call", primero.linea, primero.col);
    cu.hijo(p, llamada, "callee", callee);
    while (cu.acepta(p, tk.TType.COMMA)) { cu.hijo(p, llamada, "args", ex.expresion(p)); }
    cu.exige(p, tk.TType.R_PAREN);
    cu.hijo(p, n, "statements", var_decl(p, inicio, q.lexema, tipo, nombre.lexema, llamada, "", -1));
    return identifier(p, nombre.linea, nombre.col, nombre.lexema);
}

/- `catch ( [tipo] nombre ) bloque`. Con un solo nombre dentro de los
   paréntesis, ese nombre es el binding (`catch (e)`); con más, lo primero
   es un tipo. -/
fn atrapa(cu.Parser ptr mutable p) -> int {
    var tk.Token t = cu.exige(p, tk.TType.CATCH);
    cu.exige(p, tk.TType.L_PAREN);
    var int tipo = -1;
    if (not (cu.es_nombre(cu.actual(p).tipo) and cu.es_en(p, 1, tk.TType.R_PAREN))) {
        tipo = ti.tipo(p);
    }
    var tk.Token nombre = cu.exige_nombre(p);
    cu.exige(p, tk.TType.R_PAREN);
    var int cuerpo = bloque(p);
    var int n = cu.nodo_en(p, "CatchClause", t);
    cu.texto(p, n, "name", nombre.lexema);
    cu.hijo(p, n, "block", cuerpo);
    cu.hijo(p, n, "type", tipo);
    return n;
}

#export as sentencias
