/- semantica.enlazador — buscar y leer las librerías de un programa
   (`V0/src/linker_p/`: `resolver.py`, `cache.py`).

 Un programa y cada librería que carga son UNIDADES distintas, y cada una
 tiene su `.phir` (ver `src/hir/contrato.md`, sección 10). Este módulo guarda
 lo que comparten todas las unidades de UNA compilación:

 - el UNIVERSO de tipos: uno solo, así un tipo de librería es el mismo
   índice en el programa y en la librería;
 - las librerías ya cargadas (una vez por ruta, como la caché de la V0), con
   lo que exporta cada una en `exportes`: una sola tabla con los símbolos de
   todas, de la que el importador COPIA lo que ve;
 - dónde buscar (la raíz del proyecto y la stdlib).

 Recolectar una librería (su `collect`) es trabajo de la Semántica
 (`semantica.resolver`); aquí solo se ubica y se lee.
-/

#import frontend.tokens as tk
#import frontend.lexer as lx
#import frontend.cursor as cu
#import frontend.diagnosticos as dg
#import frontend.parser as ps
#import frontend.arbol as ar
#import semantica.tipos as tip
#import semantica.simbolos as sim
#import sistema.rutas as rt
#import sistema.archivos as arch
#import array.vector as vec
#import collections.dictionary as dic
#import text

public const str EXT_LIB = ".libsrx";
public const str EXT_FUENTE = ".srcx";
public const str PADRE = "main.libsrx";

/- Una librería cargada. Lo que exporta son TRAMOS de índices en
   `Contexto.exportes` (valores, tipos, hooks) y de `Contexto.subs`. -/
struct {
    str alias;          // el del '#export'
    str unidad;         // la unidad en el programa: el alias, o 'paquete.sub'
    str ruta;           // la del linker: el archivo, o la CARPETA de un paquete
    str archivo;        // el archivo que se analiza (el padre de un paquete)
    bool es_paquete;
    int valores_desde;  // en Contexto.lista
    int n_valores;
    int tipos_desde;
    int n_tipos;
    int hooks_desde;
    int n_hooks;
    int subs_desde;     // en Contexto.lista: índices de librería
    int n_subs;
    int internos_desde; // en Contexto.internos: sus nombres 'internal' (no se exportan)
    int n_internos;
} Libreria;

/- El estado de UNA compilación, compartido por todas sus unidades. -/
struct {
    tip.Universo u;
    sim.Tabla exportes;                  // los símbolos que exporta cada librería
    vec.Vector<Libreria> libs;
    vec.Vector<int> lista;               // los tramos de cada Libreria
    dic.Dictionary<str, int> por_ruta;   // ruta absoluta -> librería (la caché)
    dic.Dictionary<str, bool> cargando;  // ruta -> se está cargando (ciclos)
    str raiz;                            // la raíz del proyecto
    str stdlib;                          // la 'lib/' del compilador
    dic.Dictionary<str, bool> fallidas;  // ruta -> no cargó (su error ya se dijo: no se repite)
    vec.Vector<str> internos;            // los nombres 'internal' de cada librería, seguidos
    // los errores de un SUBMÓDULO de paquete que no cargó: se dicen recién
    // cuando un import lo pide ('pq.roto', o el paquete entero)
    vec.Vector<dg.Diagnostico> fallos;
    vec.Vector<int> fallo_paquete;
    vec.Vector<str> fallo_nombre;
    vec.Vector<bool> fallo_dicho;
} Contexto;

/- El contexto de una compilación. `raiz`: la carpeta del
   `.suriaX_config.yaml` más cercano subiendo desde el fuente (o la del
   fuente); `stdlib`: la `lib/` del compilador. -/
public fn contexto(str raiz, str stdlib) -> Contexto {
    return Contexto{ u: tip.universo(), exportes: sim.tabla(), libs: vec.dynamic<Libreria>(8),
                     lista: vec.dynamic<int>(64), por_ruta: dic.make<str, int>(16),
                     cargando: dic.make<str, bool>(8), raiz: raiz, stdlib: stdlib,
                     fallidas: dic.make<str, bool>(2), internos: vec.dynamic<str>(4),
                     fallos: vec.dynamic<dg.Diagnostico>(1), fallo_paquete: vec.dynamic<int>(1),
                     fallo_nombre: vec.dynamic<str>(1), fallo_dicho: vec.dynamic<bool>(1) };
}

public fn lib(Contexto ptr c, int i) -> Libreria { return c.libs.get(i); }

/- El `k`-ésimo índice de un tramo de `lista`. -/
public fn de_lista(Contexto ptr c, int desde, int k) -> int { return c.lista.get(desde + k); }

// ------------------------------------------------------------------------ //
// la raíz del proyecto y las rutas de búsqueda (resolver.py)
// ------------------------------------------------------------------------ //

/- La ruta de una librería tal como viaja en el HIR (`Module.source_file`),
   REPRODUCIBLE (`linker_p.resolver.ruta_publica`): dentro de la stdlib,
   `<stdlib>/IO/main.libsrx`; dentro del proyecto, relativa a su raíz; fuera
   de los dos, absoluta. Siempre con `/`. -/
public fn ruta_publica(Contexto ptr c, str archivo) -> str {
    var str absoluta = rt.absoluta(archivo);
    var str r = debajo_de(absoluta, c.stdlib);
    if (r != "") { return "<stdlib>/" + r; };
    r = debajo_de(absoluta, c.raiz);
    if (r != "") { return r; };
    return con_barras(absoluta);
}

/- `ruta` relativa a la carpeta `base`, con `/`; "" si no está debajo. En
   Windows (separador `\`) sin distinguir mayúsculas, como el sistema. -/
fn debajo_de(str ruta, str base) -> str {
    if (base == "") { return ""; };
    var str b = rt.absoluta(base);
    var str prefijo = b + rt.separador();
    if (len(ruta) <= len(prefijo)) { return ""; };
    var str inicio = text.slice(ruta, 0, len(prefijo));
    var bool igual = inicio == prefijo;
    if (rt.separador() == "\\") { igual = minusculas(inicio) == minusculas(prefijo); };
    if (not igual) { return ""; };
    return con_barras(text.slice(ruta, len(prefijo), len(ruta)));
}

/- `ruta` con `/` en vez del separador del sistema. -/
fn con_barras(str ruta) -> str {
    var str sep = rt.separador();
    if (sep == "/") { return ruta; };
    var str r = "";
    var int i = 0;
    while (i < len(ruta)) {
        if (ruta[i] == sep[0]) { r = r + "/"; } else { r = r + cast<str>(ruta[i]); };
        i = i + 1;
    };
    return r;
}

/- La raíz del proyecto de `fuente` (ruta absoluta): la carpeta del
   `.suriaX_config.yaml` más cercano subiendo, o la del fuente si no hay. -/
public fn raiz_del_proyecto(str fuente) -> str {
    var str inicio = rt.carpeta_de(fuente);
    var str actual = inicio;
    while (true) {
        if (rt.es_archivo(rt.une(actual, ".suriaX_config.yaml"))) { return actual; };
        var str padre = rt.carpeta_de(actual);
        if (padre == actual) { return inicio; };
        actual = padre;
    };
    return inicio;
}

/- El archivo padre de la carpeta-paquete `carpeta`, o "": `main.libsrx`,
   o `<carpeta>.libsrx` (compatibilidad). -/
public fn padre_de_paquete(str carpeta, str nombre) -> str {
    var str candidato = rt.une(carpeta, PADRE);
    if (rt.es_archivo(candidato)) { return candidato; };
    candidato = rt.une(carpeta, nombre + EXT_LIB);
    if (rt.es_archivo(candidato)) { return candidato; };
    return "";
}

/- La carpeta que CONTIENE al paquete más externo que envuelve a
   `carpeta`, o "" si no está dentro de uno. -/
fn raiz_de_paquete(str carpeta) -> str {
    var str actual = carpeta;
    var str raiz = "";
    while (padre_de_paquete(actual, rt.nombre_de(actual)) != "") {
        raiz = rt.carpeta_de(actual);
        if (raiz == actual) { return raiz; };
        actual = raiz;
    };
    return raiz;
}

/- Las rutas de búsqueda de `fuente` (absoluta), en orden y sin repetir:
   su carpeta, la raíz del paquete que la envuelve, `./lib` del proyecto y la
   stdlib. (La V1 no lee el `.suriaX_config.yaml`: usa la ruta por defecto
   de `libsrx_paths`.) -/
public fn rutas_de_busqueda(Contexto ptr c, str fuente) -> vec.Vector<str> {
    var vec.Vector<str> rutas = vec.dynamic<str>(4);
    var str propia = rt.carpeta_de(fuente);
    agrega_ruta(&rutas, propia);
    var str paquete = raiz_de_paquete(propia);
    if (paquete != "") { agrega_ruta(&rutas, paquete); };
    agrega_ruta(&rutas, rt.normaliza(rt.une(c.raiz, "./lib")));
    if (c.stdlib != "") { agrega_ruta(&rutas, c.stdlib); };
    return rutas;
}

fn agrega_ruta(vec.Vector<str> ptr mutable rutas, str r) -> void {
    var int i = 0;
    while (i < rutas.len()) {
        if (rutas.get(i) == r) { return; };
        i = i + 1;
    };
    rutas.push(r);
}

/- `nombre` en minúsculas (solo ASCII: basta para nombres de librería). -/
public fn minusculas(str s) -> str {
    var str r = "";
    var int i = 0;
    while (i < len(s)) {
        var int c = cast<int>(s[i]);
        if (c >= 65 and c <= 90) { r = r + cast<str>(cast<char>(c + 32)); }
        else { r = r + cast<str>(s[i]); };
        i = i + 1;
    };
    return r;
}

/- Lo que encontró `busca`: `clase` es "libsrx", "package", "srcx" o "" (no
   se encontró). `padre`: el archivo padre de un paquete. -/
struct {
    str ruta;
    str clase;
    str padre;
} Hallado;

/- Ubica `nombre` en `rutas` (`find_library`): en cada ruta, un archivo
   `.libsrx`, después un paquete y después un `.srcx`; con el nombre como
   está y en minúsculas. Un import punteado solo lo satisface un paquete. -/
public fn busca(str nombre, vec.Vector<str> ptr rutas, bool solo_paquetes) -> Hallado {
    var vec.Vector<str> nombres = vec.dynamic<str>(2);
    nombres.push(nombre);
    if (minusculas(nombre) != nombre) { nombres.push(minusculas(nombre)); };
    var int i = 0;
    while (i < rutas.len()) {
        var str base = rutas.get(i);
        var int k = 0;
        if (not solo_paquetes) {
            while (k < nombres.len()) {
                var str candidato = rt.une(base, nombres.get(k) + EXT_LIB);
                if (rt.es_archivo(candidato)) {
                    return Hallado{ ruta: rt.absoluta(candidato), clase: "libsrx", padre: "" };
                };
                k = k + 1;
            };
        };
        k = 0;
        while (k < nombres.len()) {
            var str carpeta = rt.une(base, nombres.get(k));
            var str padre = padre_de_paquete(carpeta, nombres.get(k));
            if (padre != "") {
                return Hallado{ ruta: rt.absoluta(carpeta), clase: "package",
                                padre: rt.absoluta(padre) };
            };
            k = k + 1;
        };
        if (not solo_paquetes) {
            k = 0;
            while (k < nombres.len()) {
                var str candidato = rt.une(base, nombres.get(k) + EXT_FUENTE);
                if (rt.es_archivo(candidato)) {
                    return Hallado{ ruta: rt.absoluta(candidato), clase: "srcx", padre: "" };
                };
                k = k + 1;
            };
        };
        i = i + 1;
    };
    return Hallado{ ruta: "", clase: "", padre: "" };
}

/- Los submódulos de la carpeta-paquete `carpeta`: sus otros `.libsrx`, en
   orden (`sorted(os.listdir)`), como rutas absolutas. -/
public fn submodulos(str carpeta, str padre) -> vec.Vector<str> {
    var vec.Vector<str> r = vec.dynamic<str>(4);
    var vec.Vector<str> nombres = arch.listar(carpeta);
    var str base_padre = rt.nombre_de(padre);
    var int i = 0;
    while (i < nombres.len()) {
        var str n = nombres.get(i);
        var int largo = len(n);
        if (largo > 7 and n != base_padre and termina_en_lib(n)) {
            r.push(rt.absoluta(rt.une(carpeta, n)));
        };
        i = i + 1;
    };
    return r;
}

fn termina_en_lib(str n) -> bool {
    var int largo = len(n);
    var int e = len(EXT_LIB);
    if (largo < e) { return false; };
    var int i = 0;
    while (i < e) {
        if (n[largo - e + i] != EXT_LIB[i]) { return false; };
        i = i + 1;
    };
    return true;
}

// ------------------------------------------------------------------------ //
// leer un archivo
// ------------------------------------------------------------------------ //

/- El árbol de un archivo, con sus errores léxicos y de sintaxis. -/
struct {
    cu.Parser p;
    int raiz;
    vec.Vector<dg.Diagnostico> errores;   // léxicos y de sintaxis, en ese orden
} Arbol;

/- Lee y parsea `ruta`. -/
public fn lee(str ruta) -> Arbol {
    var vec.Vector<dg.Diagnostico> errores = vec.dynamic<dg.Diagnostico>(4);
    var vec.Vector<tk.Token> toks = lx.tokenizar(arch.leer(ruta), &errores);
    var int ultimo = toks.len() - 1;
    var cu.Parser p = cu.Parser{ toks: move toks, pos: 0, fin: ultimo,
                                 arbol: vec.dynamic<ar.Nodo>(256), sin_literal: false,
                                 bucles: 0, receptores: vec.dynamic<int>(4), guardianes: 0,
                                 en_finally: -1 };
    var int raiz = ps.programa(&p, &errores);
    return Arbol{ p: move p, raiz: raiz, errores: move errores };
}

#export as enlazador
