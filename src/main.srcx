/- La V1: el compilador de suriaX escrito en suriaX.

     suri src/main.srcx <fuente.srcx> <salida.phir> [-O0] [--stdlib <carpeta>]

 Lee el fuente, lo analiza (lexer, parser, Semántica) y escribe su HIR, y
 el de cada librería que carga (una unidad por `.phir`, junto al del
 programa). La meta del bootstrap es que cada `.phir` sea IDÉNTICO, byte a
 byte, al que produce la V0 (`V0/main.py fuente --emit-hir`).

 La stdlib (`lib/` del compilador) sale de `SURIAX_STDLIB` o de `--stdlib`:
 la V0 la deduce de dónde está instalada, y la V1 —un `.phir` que corre en
 la VM— no tiene forma de saberlo.

 Cubre un SUBCONJUNTO del lenguaje (ver `src/readme.md`): lo que queda
 fuera se informa y detiene la compilación (nunca un `.phir` incompleto).
 Los errores léxicos, de sintaxis y semánticos se informan como en la V0
 (`ruta:linea:col: CODIGO mensaje`, en el mismo orden) y detienen la
 compilación; los semánticos llegan por tandas (lote 18).
-/

#from io #import stdp
#import frontend.arbol as ar
#import semantica.nodos as nd
#import semantica.resolver as res
#import semantica.enlazador as enl
#import frontend.diagnosticos as dg
#import hir.emisor as em
#import sistema.archivos as arch
#import sistema.proceso as proc
#import sistema.rutas as rt
#import array.vector as vec
#import collections.dictionary as dic

/- El nivel de optimización pedido (`-O0`, `-O1`, `-O2`), o -1 si el
   argumento no es un nivel. -/
fn nivel_de(str arg) -> int {
    if (arg == "-O0") { return 0; };
    if (arg == "-O1") { return 1; };
    if (arg == "-O2") { return 2; };
    return -1;
}

/- Escribe los diagnósticos a la salida de errores, en orden, como
   `ruta:linea:col: CODIGO mensaje` (la forma que leen los editores). ¿Hay
   alguno que detenga la compilación? (un aviso o una nota, no) -/
fn reporta(vec.Vector<dg.Diagnostico> ptr ds, str ruta) -> bool {
    var bool bloquea = false;
    var int i = 0;
    while (i < ds.len()) {
        var dg.Diagnostico d = ds.get(i);
        // el de una librería lleva SU archivo
        var str donde = ruta;
        if (d.archivo != "") { donde = d.archivo; };
        proc.escribir_error(f"{donde}:{d.linea}:{d.col}: {d.codigo} {d.mensaje}\n");
        if (dg.bloquea(d)) { bloquea = true; };
        i = i + 1;
    };
    return bloquea;
}

/- ¿El árbol usa algo que la V1 todavía no emite? Lo dice (con su posición,
   sin código: no es un error del programa, que para la V0 es válido) y
   detiene la compilación: un `.phir` incompleto sin aviso sería peor. -/
fn fuera_del_subconjunto(vec.Vector<ar.Nodo> ptr a, int raiz, res.Analisis ptr r,
                         str ruta) -> bool {
    var int n = em.no_soportado(a, raiz, r);
    if (n < 0) { return false; };
    var str que = em.que_falta(nd.clase(a, n));
    if (que == "") { que = r.no_emitible.get(n); };
    proc.escribir_error(f"{ruta}:{nd.linea(a, n)}:{nd.col(a, n)}: la V1 todavía no compila "
                        + f"{que} (fuera de su subconjunto, ver src/readme.md); compílalo con "
                        + "la V0\n");
    return true;
}

fn main() -> int {
    // los argumentos: dos posicionales (fuente y salida), el nivel de
    // optimización y la stdlib. '-O0' (el defecto) NO optimiza: es el que da
    // el .phir IDÉNTICO al de la V0, y el único con el que el punto fijo del
    // bootstrap tiene sentido. La V1 no optimiza: las optimizaciones llegan
    // con la V3; hasta entonces pedirlas es un error, no un silencio.
    var vec.Vector<str> posicionales = vec.dynamic<str>(2);
    var int nivel = 0;
    var str stdlib = rt.entorno("SURIAX_STDLIB");
    var int i = 1;
    while (i < proc.argumentos()) {
        var str arg = proc.argumento(i);
        var int n = nivel_de(arg);
        if (n >= 0) {
            nivel = n;
        } else if (arg == "--stdlib" and i + 1 < proc.argumentos()) {
            stdlib = proc.argumento(i + 1);
            i = i + 1;
        } else {
            posicionales.push(arg);
        };
        i = i + 1;
    };
    if (posicionales.len() != 2) {
        proc.escribir_error("uso: main.srcx <fuente.srcx> <salida.phir> [-O0|-O1|-O2] "
                            + "[--stdlib <carpeta>]\n");
        return 2;
    };
    if (nivel > 0) {
        proc.escribir_error(f"-O{nivel}: la V1 no optimiza (las optimizaciones llegan con "
                            + "la V3); usa -O0\n");
        return 2;
    };
    if (stdlib != "") { stdlib = rt.absoluta(stdlib); };
    var str ruta = posicionales.get(0);
    var str salida = posicionales.get(1);
    var str absoluta = rt.absoluta(ruta);

    var enl.Contexto ctx = enl.contexto(enl.raiz_del_proyecto(absoluta), stdlib);
    var enl.Arbol arbol = enl.lee(ruta);
    // un error léxico o de sintaxis detiene aquí: el árbol es el "mejor
    // esfuerzo" de la recuperación, y analizarlo daría errores falsos (la V0
    // tampoco lo hace)
    if (reporta(&arbol.errores, ruta)) { return 1; };
    var res.Analisis analisis = res.analiza(&arbol.p.arbol, arbol.raiz, &ctx, absoluta, "");
    // los diagnósticos de la Semántica: con alguno que bloquee, no hay .phir
    if (reporta(&analisis.diagnosticos, ruta)) { return 1; };
    if (fuera_del_subconjunto(&arbol.p.arbol, arbol.raiz, &analisis, ruta)) { return 1; };
    // el programa lleva su ruta como se la pasaron; cada librería, su ruta
    // pública (como la V0)
    var vec.Vector<byte> bytes = em.emite(&arbol.p.arbol, arbol.raiz, &analisis, ruta);
    // la carpeta de salida y las que le falten, como la V0 ('mkdir -p')
    if (rt.carpeta_de(salida) != "") { arch.crear_carpeta(rt.carpeta_de(salida)); };
    arch.write_bytes(salida, &bytes);
    stdp.println(f"HIR ({bytes.len()} bytes) -> {salida}");

    // las unidades: las que importa el programa y, de cada una, las que
    // importa ella; cada una se analiza OTRA VEZ como un programa propio (con
    // su unidad) y se emite como '<unidad>.phir' junto al del programa
    var str carpeta = rt.carpeta_de(salida);
    var vec.Vector<int> pendientes = vec.dynamic<int>(8);
    i = 0;
    while (i < analisis.librerias.len()) {
        pendientes.push(analisis.librerias.get(i));
        i = i + 1;
    };
    var dic.Dictionary<str, bool> hechas = dic.make<str, bool>(8);
    while (pendientes.len() > 0) {
        var enl.Libreria info = enl.lib(&ctx, pendientes.pop());
        if (not hechas.contains(info.unidad)) {
            hechas.put(info.unidad, true);
            var enl.Arbol lib = enl.lee(info.archivo);
            if (reporta(&lib.errores, info.archivo)) { return 1; };
            var vec.Vector<int> items = nd.hijos(&lib.p.arbol, lib.raiz, "items");
            var str alias = nd.atributo(&lib.p.arbol, items.get(items.len() - 1), "alias");
            var res.Analisis unidad = res.analiza(&lib.p.arbol, lib.raiz, &ctx, info.archivo,
                                                  alias);
            // sus diagnósticos, con su archivo (como la V0 al compilar cada unidad)
            if (reporta(&unidad.diagnosticos, info.archivo)) { return 1; };
            if (fuera_del_subconjunto(&lib.p.arbol, lib.raiz, &unidad, info.archivo)) { return 1; };
            var int k = 0;
            while (k < unidad.librerias.len()) {
                pendientes.push(unidad.librerias.get(k));
                k = k + 1;
            };
            // su ruta PÚBLICA (reproducible: relativa a la stdlib o al proyecto)
            var vec.Vector<byte> datos = em.emite(&lib.p.arbol, lib.raiz, &unidad,
                                                  enl.ruta_publica(&ctx, info.archivo));
            var str destino = rt.une(carpeta, info.unidad + ".phir");
            arch.write_bytes(destino, &datos);
            stdp.println(f"  unidad '{info.unidad}': {datos.len()} bytes -> {destino}");
        };
    };
    return 0;
}
